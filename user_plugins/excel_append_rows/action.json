{
  "id": "excel_append_rows",
  "name": "Excel 追加记录",
  "description": "把前一步输出的记录列表追加到 .xlsx 工作表；可按指定列去重。适合上传、备份、下载等任意流水线。",
  "version_code": 1,
  "version": "0.1.0-alpha",
  "package_name": "io.github.notmyfault.excel_append_rows",
  "enabled": true,
  "permissions": ["filesystem"],
  "origin": "user",
  "execution_api": "context-v1",
  "outputs": ["appended", "skipped", "workbook_path"],
  "params": [
    {
      "name": "excel_path",
      "label": "Excel 文件",
      "type": "path",
      "default": "",
      "placeholder": "选择或填写 .xlsx 文件"
    },
    {
      "name": "records",
      "label": "要追加的记录（引用上一步输出）",
      "type": "textarea",
      "default": "",
      "placeholder": "例如 {{ steps.tianyi_upload.result.uploaded_files }}"
    },
    {
      "name": "sheet_name",
      "label": "工作表名称",
      "type": "string",
      "default": "归档记录"
    },
    {
      "name": "deduplicate_by",
      "label": "去重列（逗号分隔）",
      "type": "string",
      "default": "local_path,md5,remote_id",
      "placeholder": "留空则不去重"
    }
  ]
}
