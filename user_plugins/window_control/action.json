{
    "id": "window_control",
    "name": "窗口控制",
    "description": "对窗口执行最小化/最大化/关闭/隐藏/置前/移动/调整大小等操作",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.window_control",
    "enabled": true,
    "permissions": ["native_api"],
    "params": [
        {
            "name": "target",
            "label": "目标窗口",
            "type": "select",
            "default": "active",
            "options": [
                {"value": "active", "label": "当前活动窗口"},
                {"value": "title", "label": "按标题匹配"}
            ]
        },
        {
            "name": "title",
            "label": "窗口标题（模糊匹配）",
            "type": "string",
            "default": "",
            "placeholder": "如 Chrome、记事本",
            "visible_when": {"target": ["title"]}
        },
        {
            "name": "action",
            "label": "操作",
            "type": "select",
            "default": "bring_to_front",
            "visible_when": {"target": ["active", "title"]},
            "options": [
                {"value": "bring_to_front", "label": "置前激活"},
                {"value": "minimize", "label": "最小化"},
                {"value": "maximize", "label": "最大化"},
                {"value": "restore", "label": "还原"},
                {"value": "close", "label": "关闭"},
                {"value": "hide", "label": "隐藏"},
                {"value": "move", "label": "移动"},
                {"value": "resize", "label": "调整大小"}
            ]
        },
        {
            "name": "x",
            "label": "X 坐标",
            "type": "number",
            "default": 0,
            "visible_when": {"action": ["move"]}
        },
        {
            "name": "y",
            "label": "Y 坐标",
            "type": "number",
            "default": 0,
            "visible_when": {"action": ["move"]}
        },
        {
            "name": "width",
            "label": "宽度",
            "type": "number",
            "default": 800,
            "visible_when": {"action": ["resize"]}
        },
        {
            "name": "height",
            "label": "高度",
            "type": "number",
            "default": 600,
            "visible_when": {"action": ["resize"]}
        }
    ]
}
