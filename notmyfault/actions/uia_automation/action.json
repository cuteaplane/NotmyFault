{
  "id": "uia_automation",
  "name": "UIA 自动化",
  "description": "选择、读取和操作 Windows UI Automation 控件，或录制并重放桌面操作",
  "version_code": 1,
  "version": "1.0",
  "package_name": "io.github.notmyfault.uia_automation",
  "enabled": true,
  "execution_api": "context-v1",
  "cancellation_api": "runtime-v1",
  "platforms": [
    "windows"
  ],
  "entrypoints": {
    "windows": "action.py"
  },
  "permissions": [
    "native_api",
    "screen_reader",
    "input_monitor"
  ],
  "contributes": {
    "commands": [
      {
        "id": "edit_selector",
        "title": "选择屏幕控件",
        "handler": "selector_extension.py:edit_selector"
      },
      {
        "id": "capture_selector",
        "title": "采集屏幕控件",
        "handler": "selector_extension.py:capture_selector"
      },
      {
        "id": "verify_selector",
        "title": "检查屏幕控件",
        "handler": "selector_extension.py:verify_selector"
      },
      {
        "id": "commit_selector",
        "title": "保存屏幕控件",
        "handler": "selector_extension.py:commit_selector"
      },
      {
        "id": "cancel_selector",
        "title": "取消编辑屏幕控件",
        "handler": "selector_extension.py:cancel_selector"
      },
      {
        "id": "open_macro",
        "title": "打开操作宏编辑器",
        "handler": "component.py:open_macro"
      },
      {
        "id": "start_recording",
        "title": "开始录制操作",
        "handler": "component.py:start_recording"
      },
      {
        "id": "recording_status",
        "title": "读取录制状态",
        "handler": "component.py:recording_status"
      },
      {
        "id": "stop_recording",
        "title": "停止录制操作",
        "handler": "component.py:stop_recording"
      },
      {
        "id": "commit_macro",
        "title": "保存操作宏",
        "handler": "component.py:commit_macro"
      },
      {
        "id": "cancel_macro",
        "title": "取消编辑操作宏",
        "handler": "component.py:cancel_macro"
      }
    ],
    "views": [
      {
        "id": "selector_workbench",
        "title": "屏幕控件编辑器",
        "description": "采集并检查 Windows UI Automation 控件",
        "page": "pages/selector.html",
        "commands": [
          "capture_selector",
          "verify_selector",
          "commit_selector",
          "cancel_selector"
        ]
      },
      {
        "id": "macro_workbench",
        "title": "操作宏编辑器",
        "description": "录制鼠标、键盘和操作间隔，鼠标点击优先识别 UIA 控件",
        "page": "pages/macro.html",
        "commands": [
          "start_recording",
          "recording_status",
          "stop_recording",
          "commit_macro",
          "cancel_macro"
        ],
        "window_controls": [
          "minimize",
          "restore"
        ]
      }
    ],
    "data_types": [
      {
        "id": "uia_selector",
        "version": 1,
        "binding": "private"
      },
      {
        "id": "mouse_macro",
        "version": 1,
        "binding": "private"
      }
    ],
    "parameter_editors": [
      {
        "id": "selector_editor",
        "parameter": "target",
        "data_type": "uia_selector",
        "command": "edit_selector",
        "view": "selector_workbench",
        "ui": {
          "control": "button",
          "empty_label": "选择屏幕控件",
          "busy_label": "等待读取控件…",
          "icon": "center_focus_strong",
          "description": "点击后把鼠标停在目标控件上，三秒后读取"
        }
      },
      {
        "id": "macro_editor",
        "parameter": "macro",
        "data_type": "mouse_macro",
        "command": "open_macro",
        "view": "macro_workbench",
        "ui": {
          "control": "button",
          "empty_label": "录制操作宏",
          "icon": "movie",
          "description": "走一遍操作即可记录鼠标、键盘和时间间隔；数据由插件自己管理"
        }
      }
    ]
  },
  "params": [
    {
      "name": "mode",
      "label": "自动化方式",
      "type": "select",
      "default": "control",
      "required": true,
      "options": [
        {
          "value": "control",
          "label": "操作屏幕控件"
        },
        {
          "value": "focus_window",
          "label": "切换到控件窗口"
        },
        {
          "value": "read_text",
          "label": "读取控件文本"
        },
        {
          "value": "wait",
          "label": "等待控件出现"
        },
        {
          "value": "macro",
          "label": "执行操作宏"
        }
      ]
    },
    {
      "name": "target",
      "label": "屏幕控件",
      "type": "plugin_data",
      "data_type": "uia_selector",
      "value_type": "object",
      "required": false,
      "sensitive": true,
      "summary": "hidden",
      "visible_when": {
        "mode": [
          "control",
          "focus_window",
          "read_text",
          "wait"
        ]
      }
    },
    {
      "name": "operation",
      "label": "控件操作",
      "type": "select",
      "default": "invoke",
      "options": [
        {
          "value": "invoke",
          "label": "按下控件"
        },
        {
          "value": "focus",
          "label": "让控件获得焦点"
        },
        {
          "value": "set_text",
          "label": "写入文本"
        }
      ],
      "visible_when": {
        "mode": [
          "control"
        ]
      }
    },
    {
      "name": "text",
      "label": "要写入的文本",
      "type": "textarea",
      "default": "",
      "placeholder": "这段文字会保存在规则中，请不要填写密码",
      "rows": 3,
      "sensitive": true,
      "summary": "hidden",
      "visible_when": {
        "mode": [
          "control"
        ],
        "operation": [
          "set_text"
        ]
      },
      "value_type": "text"
    },
    {
      "name": "wait_seconds",
      "label": "最多等待（秒）",
      "type": "number",
      "default": 30,
      "min": 1,
      "max": 600,
      "step": 1,
      "visible_when": {
        "mode": [
          "wait"
        ]
      },
      "value_type": {
        "type": "duration",
        "unit": "seconds"
      }
    },
    {
      "name": "macro",
      "label": "操作宏",
      "type": "plugin_data",
      "data_type": "mouse_macro",
      "value_type": "object",
      "required": false,
      "sensitive": true,
      "summary": "hidden",
      "visible_when": {
        "mode": [
          "macro"
        ]
      }
    }
  ],
  "outputs": [
    {
      "name": "operation",
      "label": "执行的操作",
      "type": "string",
      "required": false,
      "summary": "value",
      "value_type": "text"
    },
    {
      "name": "display",
      "label": "控件说明",
      "type": "object",
      "required": false,
      "summary": "shape",
      "value_type": "object"
    },
    {
      "name": "focused",
      "label": "已经切换",
      "type": "bool",
      "required": false,
      "summary": "value",
      "value_type": "bool"
    },
    {
      "name": "text",
      "label": "读取的文本",
      "type": "string",
      "required": false,
      "sensitive": true,
      "summary": "hidden",
      "value_type": "text"
    },
    {
      "name": "found",
      "label": "已经出现",
      "type": "bool",
      "required": false,
      "summary": "value",
      "value_type": "bool"
    },
    {
      "name": "bounds",
      "label": "控件屏幕范围",
      "type": "object",
      "required": false,
      "summary": "shape",
      "value_type": {
        "type": "object",
        "properties": {
          "left": "int",
          "top": "int",
          "width": "int",
          "height": "int"
        }
      }
    },
    {
      "name": "executed",
      "label": "已执行步骤",
      "type": "number",
      "required": false,
      "summary": "value",
      "value_type": "int"
    },
    {
      "name": "steps",
      "label": "执行步骤详情",
      "type": "array",
      "required": false,
      "sensitive": true,
      "summary": "hidden",
      "value_type": "array"
    }
  ],
  "idempotent": false
}
