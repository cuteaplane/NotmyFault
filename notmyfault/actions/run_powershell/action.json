{
    "id": "run_powershell",
    "name": "执行 PowerShell",
    "description": "执行一段 Windows PowerShell 命令",
    "version_code": 2,
    "version": "1.1",
    "package_name": "io.github.notmyfault.run_powershell",
    "enabled": true,
    "idempotent": false,
    "execution_api": "context-v1",
    "cancellation_api": "runtime-v1",
    "permissions": [
        "external_binary",
        "native_api"
    ],
    "security": {
        "rule_approval": "admin_key",
        "literal_only_params": [
            "command"
        ]
    },
    "outputs": [
        {
            "name": "returncode",
            "label": "退出状态",
            "type": "number",
            "value_type": "int"
        },
        {
            "name": "stdout",
            "label": "标准输出",
            "type": "string",
            "sensitive": true,
            "summary": "hidden"
        },
        {
            "name": "stderr",
            "label": "标准错误",
            "type": "string",
            "sensitive": true,
            "summary": "hidden"
        }
    ],
    "params": [
        {
            "name": "command",
            "label": "PowerShell 命令",
            "type": "textarea",
            "default": "",
            "sensitive": true,
            "summary": "hidden",
            "placeholder": "要执行的 PowerShell 命令",
            "rows": 8
        },
        {
            "name": "encoding",
            "label": "命令输出编码",
            "type": "string",
            "value_type": "text",
            "default": "oem",
            "placeholder": "默认 oem；命令使用 UTF-8 输出时填 utf-8",
            "options": [
                {"value": "oem", "label": "系统 OEM 编码"},
                {"value": "utf-8", "label": "UTF-8"},
                {"value": "utf-8-sig", "label": "UTF-8，去除 BOM"},
                {"value": "gb18030", "label": "GB18030"},
                {"value": "utf-16-le", "label": "UTF-16 LE"}
            ]
        }
    ],
    "platforms": [
        "windows"
    ]
}
