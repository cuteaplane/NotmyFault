{
    "id": "run_powershell",
    "name": "执行 PowerShell",
    "description": "执行一段 PowerShell 命令",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.run_powershell",
    "enabled": true,
    "idempotent": false,
    "execution_api": "context-v1",
    "cancellation_api": "runtime-v1",
    "permissions": [
        "external_binary",
        "native_api"
    ],
    "security": {
        "rule_approval": "admin_key",
        "literal_only_params": [
            "command"
        ]
    },
    "outputs": [
        {
            "name": "returncode",
            "label": "退出状态",
            "type": "number",
            "value_type": "int"
        },
        {
            "name": "stdout",
            "label": "标准输出",
            "type": "string",
            "sensitive": true,
            "summary": "hidden"
        },
        {
            "name": "stderr",
            "label": "标准错误",
            "type": "string",
            "sensitive": true,
            "summary": "hidden"
        }
    ],
    "params": [
        {
            "name": "command",
            "label": "PowerShell 命令",
            "type": "textarea",
            "default": "",
            "sensitive": true,
            "summary": "hidden",
            "placeholder": "要执行的 PowerShell 命令",
            "rows": 8
        }
    ]
}
