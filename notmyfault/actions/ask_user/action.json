{
    "id": "ask_user",
    "name": "询问用户",
    "description": "弹出桌面消息框或输入框，等待用户确认或填写文本后继续工作流",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.ask_user",
    "enabled": true,
    "idempotent": false,
    "platforms": [
        "windows",
        "linux"
    ],
    "permissions": [
        "native_api",
        "external_binary"
    ],
    "outputs": [
        {
            "name": "ok",
            "label": "对话框是否可用",
            "type": "bool",
            "value_type": "bool"
        },
        {
            "name": "confirmed",
            "label": "用户是否确认",
            "type": "bool",
            "value_type": "bool"
        },
        {
            "name": "text",
            "label": "输入文本",
            "type": "string",
            "required": false
        },
        {
            "name": "mode",
            "label": "交互方式",
            "type": "string"
        },
        {
            "name": "title",
            "label": "标题",
            "type": "string",
            "required": false
        },
        {
            "name": "error",
            "label": "错误说明",
            "type": "string",
            "required": false
        }
    ],
    "params": [
        {
            "name": "mode",
            "label": "交互方式",
            "type": "select",
            "default": "message",
            "options": [
                {
                    "value": "message",
                    "label": "消息框（仅确定）"
                },
                {
                    "value": "input",
                    "label": "输入框（返回文本）"
                }
            ]
        },
        {
            "name": "title",
            "label": "标题",
            "type": "string",
            "default": "NotmyFault",
            "placeholder": "对话框标题"
        },
        {
            "name": "message",
            "label": "提示内容",
            "type": "textarea",
            "default": "",
            "placeholder": "显示给用户的说明文字",
            "rows": 4
        },
        {
            "name": "default",
            "label": "默认输入",
            "type": "string",
            "default": "",
            "placeholder": "输入框的预填文本",
            "visible_when": {
                "mode": [
                    "input"
                ]
            }
        }
    ]
}
