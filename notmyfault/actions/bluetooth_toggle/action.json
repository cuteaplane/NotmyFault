{
    "id": "bluetooth_toggle",
    "name": "开关蓝牙",
    "description": "打开或关闭蓝牙适配器",
    "version_code": 2,
    "version": "1.1",
    "package_name": "io.github.notmyfault.bluetooth_toggle",
    "enabled": true,
    "permissions": [
        "admin",
        "external_binary"
    ],
    "params": [
        {
            "name": "action",
            "label": "操作",
