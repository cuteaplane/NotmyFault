{
    "id": "bluetooth_toggle",
    "name": "开关蓝牙",
    "description": "打开或关闭蓝牙适配器",
    "version_code": 4,
    "version": "2.0",
    "package_name": "io.github.notmyfault.bluetooth_toggle",
    "requires_capabilities": ["bluetooth.control"],
    "platforms": ["windows", "linux"],
    "enabled": true,
    "permissions": ["external_binary", "native_api"],
    "outputs": [
        {"name": "state", "label": "蓝牙状态", "type": "string"},
        {"name": "changed", "label": "状态是否改变", "type": "bool"},
        {"name": "method", "label": "控制方式", "type": "string"}
    ],
    "params": [
        {
            "name": "action",
            "label": "操作",
            "type": "select",
            "default": "toggle",
            "options": [
                {"value": "toggle", "label": "切换开关状态"},
                {"value": "on", "label": "开启蓝牙"},
                {"value": "off", "label": "关闭蓝牙"},
                {"value": "query", "label": "查询蓝牙状态"}
            ]
        }
    ]
}
