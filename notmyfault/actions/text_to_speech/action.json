{
    "id": "text_to_speech",
    "name": "语音播报",
    "description": "将文字转为语音朗读（TTS，使用 Windows SAPI）",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.text_to_speech",
    "enabled": true,
    "permissions": ["audio", "native_api"],
    "params": [
        {
            "name": "text",
            "label": "播报文本",
            "type": "string",
            "default": "",
            "placeholder": "要朗读的内容"
        },
        {
            "name": "rate",
            "label": "语速 (-10 ~ 10)",
            "type": "number",
            "default": 0
        },
        {
            "name": "volume",
            "label": "音量 (0-100)",
            "type": "number",
            "default": 100
        }
    ]
}