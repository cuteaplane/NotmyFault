{
    "id": "screen_ocr",
    "name": "屏幕文字识别",
    "description": "截取整个屏幕或指定区域，识别其中的文字",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.screen_ocr",
    "enabled": true,
    "idempotent": false,
    "requires_capabilities": ["screen.capture", "screen.ocr"],
    "platforms": ["windows", "linux"],
    "permissions": ["screen_reader", "filesystem", "native_api", "external_binary"],
    "outputs": [
        {"name": "text", "label": "识别文本", "type": "string"},
        {"name": "language", "label": "识别语言", "type": "string"}
    ],
    "params": [
        {
            "name": "mode",
            "label": "识别范围",
            "type": "select",
            "default": "fullscreen",
            "options": [
                {"value": "fullscreen", "label": "整个屏幕"},
                {"value": "region", "label": "指定区域"}
            ]
        },
        {
            "name": "x",
            "label": "距左边",
            "type": "number",
            "value_type": {"type": "int"},
            "default": 0,
            "placeholder": "从截图左上角向右的像素，不能为负",
            "visible_when": {"mode": ["region"]}
        },
        {
            "name": "y",
            "label": "距上边",
            "type": "number",
            "value_type": {"type": "int"},
            "default": 0,
            "placeholder": "从截图左上角向下的像素，不能为负",
            "visible_when": {"mode": ["region"]}
        },
        {
            "name": "width",
            "label": "宽度",
            "type": "number",
            "value_type": {"type": "int"},
            "default": 0,
            "placeholder": "区域宽度，至少 1 像素",
            "visible_when": {"mode": ["region"]}
        },
        {
            "name": "height",
            "label": "高度",
            "type": "number",
            "value_type": {"type": "int"},
            "default": 0,
            "placeholder": "区域高度，至少 1 像素",
            "visible_when": {"mode": ["region"]}
        },
        {
            "name": "language",
            "label": "识别语言",
            "type": "string",
            "default": "chi_sim+eng",
            "placeholder": "tesseract 语言，例如 chi_sim+eng 或 eng"
        }
    ]
}
