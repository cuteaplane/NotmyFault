{
    "id": "launch_program",
    "name": "启动程序",
    "description": "启动指定程序或打开文件",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.launch_program",
    "enabled": true,
    "permissions": [
        "external_binary"
    ],
    "params": [
        {
            "name": "path",
            "label": "程序路径",
            "type": "string",
            "default": "",
            "placeholder": "exe 路径、系统命令或文件路径"
        },
        {
            "name": "args",
            "label": "启动参数",
            "type": "string",
            "default": "",
            "placeholder": "可选，命令行参数"
        }
    ]
}
