{
    "id": "set_default_audio",
    "name": "设置默认音频设备",
    "description": "切换系统默认播放或录音设备",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.set_default_audio",
    "requires_capabilities": ["audio.device_query"],
    "execution_api": "context-v1",
    "idempotent": true,
    "platforms": ["windows", "linux"],
    "permissions": ["audio", "external_binary", "native_api"],
    "outputs": [
        {"name": "device_type", "label": "设备类型", "type": "string"},
        {"name": "device_id", "label": "当前设备", "type": "string"},
        {"name": "device_name", "label": "设备名称", "type": "string", "required": false},
        {"name": "previous_device_id", "label": "上一个设备", "type": "string"},
        {"name": "changed", "label": "是否发生切换", "type": "bool"},
        {"name": "method", "label": "控制方式", "type": "string"}
    ],
    "params": [
        {
            "name": "device_type",
            "label": "设备类型",
            "type": "select",
            "default": "render",
            "options": [
                {"value": "render", "label": "播放设备"},
                {"value": "capture", "label": "录音设备"}
            ]
        },
        {
            "name": "device",
            "label": "目标设备",
            "type": "string",
            "default": "",
            "placeholder": "设备 id 或名称，可与音频设备变化触发器的设备 id 对应"
        }
    ]
}
