{
    "id": "screenshot",
    "name": "截图",
    "description": "截取屏幕并保存为图片文件",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.screenshot",
    "enabled": true,
    "permissions": ["screen_reader", "filesystem", "native_api"],
    "params": [
        {
            "name": "mode",
            "label": "截取范围",
            "type": "select",
            "default": "fullscreen",
            "options": ["fullscreen", "active_window"]
        },
        {
            "name": "output_path",
            "label": "保存路径",
            "type": "string",
            "default": "",
            "placeholder": "留空=桌面带时间戳文件名"
        },
        {
            "name": "format",
            "label": "图片格式",
            "type": "select",
            "default": "png",
            "options": ["png", "jpg"]
        }
    ]
}
