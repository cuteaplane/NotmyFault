{
    "id": "notify",
    "name": "显示通知",
    "description": "显示系统通知消息",
    "version_code": 2,
    "version": "1.1",
    "package_name": "io.github.notmyfault.notify",
    "enabled": true,
    "permissions": ["notification"],
    "params": [
        {
            "name": "title",
            "label": "通知标题",
            "type": "string",
            "default": "NotmyFault",
            "placeholder": "通知的标题"
        },
        {
            "name": "message",
            "label": "通知内容",
            "type": "textarea",
            "default": "",
            "placeholder": "通知的正文内容",
            "rows": 5
        }
    ]
}
