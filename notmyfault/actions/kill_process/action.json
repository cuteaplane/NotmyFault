{
    "id": "kill_process",
    "name": "终止进程",
    "description": "按进程名终止运行中的进程",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.kill_process",
    "enabled": true,
    "idempotent": false,
    "execution_api": "context-v1",
    "cancellation_api": "runtime-v1",
    "permissions": ["process"],
    "security": {
        "rule_approval": "admin_key",
        "literal_only_params": ["process_name"]
    },
    "outputs": [
        {"name": "killed", "label": "已终止进程数", "type": "number", "value_type": "int"},
        {"name": "denied", "label": "权限不足的进程数", "type": "number", "value_type": "int"}
    ],
    "params": [
        {
            "name": "process_name",
            "label": "进程名",
            "type": "string",
            "default": "",
            "placeholder": "如 Notepad.exe、WeChat.exe"
        }
    ]
}
