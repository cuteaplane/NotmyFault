{
    "id": "uia_control",
    "name": "操作屏幕控件",
    "description": "按下或聚焦通过 Windows UI Automation 选择的控件",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.uia_control",
    "enabled": true,
    "execution_api": "context-v1",
    "platforms": ["windows"],
    "entrypoints": {
        "windows": "action.py"
    },
    "permissions": ["native_api", "screen_reader"],
    "components": [
        {
            "id": "record",
            "name": "录制屏幕控件",
            "description": "依次选择要操作的屏幕控件，生成可重复执行的步骤",
            "entrypoint": "component.py",
            "ui": {
                "button_label": "录制桌面步骤",
                "icon": "screen_record",
                "description": "依次选择要操作的屏幕控件"
            }
        }
    ],
    "params": [
        {
            "name": "target",
            "label": "屏幕控件",
            "type": "uia_selector",
            "value_type": "object",
            "required": true,
            "sensitive": true,
            "summary": "hidden"
        },
        {
            "name": "operation",
            "label": "怎么操作",
            "type": "select",
            "default": "invoke",
            "options": [
                {"value": "invoke", "label": "按下控件"},
                {"value": "focus", "label": "让控件获得焦点"},
                {"value": "set_text", "label": "写入文本"}
            ]
        },
        {
            "name": "text",
            "label": "要写入的文本",
            "type": "textarea",
            "default": "",
            "placeholder": "这段文字会保存在规则中，请不要填写密码",
            "rows": 3,
            "sensitive": true,
            "summary": "hidden",
            "visible_when": {"operation": ["set_text"]}
        }
    ],
    "outputs": [
        {
            "name": "operation",
            "label": "执行的操作",
            "type": "string",
            "summary": "value"
        },
        {
            "name": "display",
            "label": "控件说明",
            "type": "object",
            "summary": "shape"
        }
    ],
    "idempotent": false
}
