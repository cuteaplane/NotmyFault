{
    "id": "uia_control",
    "name": "操作屏幕控件",
    "description": "按下或聚焦通过 Windows UI Automation 选择的控件",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.uia_control",
    "enabled": true,
    "execution_api": "context-v1",
    "platforms": ["windows"],
    "entrypoints": {
        "windows": "action.py"
    },
    "permissions": ["native_api", "screen_reader"],
    "contributes": {
        "commands": [
            {
                "id": "edit_selector",
                "title": "选择屏幕控件",
                "handler": "extension.py:edit_selector"
            }
        ],
        "parameter_editors": [
            {
                "id": "selector_editor",
                "parameter": "target",
                "value_type": "object",
                "command": "edit_selector",
                "ui": {
                    "control": "button",
                    "empty_label": "选择屏幕控件",
                    "icon": "center_focus_strong",
                    "description": "把鼠标停在目标控件上，等待识别"
                }
            }
        ]
    },
    "params": [
        {
            "name": "target",
            "label": "屏幕控件",
            "type": "uia_selector",
            "value_type": "object",
            "required": true,
            "sensitive": true,
            "summary": "hidden"
        },
        {
            "name": "operation",
            "label": "怎么操作",
            "type": "select",
            "default": "invoke",
            "options": [
                {"value": "invoke", "label": "按下控件"},
                {"value": "focus", "label": "让控件获得焦点"},
                {"value": "set_text", "label": "写入文本"}
            ]
        },
        {
            "name": "text",
            "label": "要写入的文本",
            "type": "textarea",
            "default": "",
            "placeholder": "这段文字会保存在规则中，请不要填写密码",
            "rows": 3,
            "sensitive": true,
            "summary": "hidden",
            "visible_when": {"operation": ["set_text"]}
        }
    ],
    "outputs": [
        {
            "name": "operation",
            "label": "执行的操作",
            "type": "string",
            "summary": "value"
        },
        {
            "name": "display",
            "label": "控件说明",
            "type": "object",
            "summary": "shape"
        }
    ],
    "idempotent": false
}
