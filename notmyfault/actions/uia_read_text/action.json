{
    "id": "uia_read_text",
    "name": "读取屏幕控件文本",
    "description": "读取通过 Windows UI Automation 选择的控件文本",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.uia_read_text",
    "enabled": true,
    "execution_api": "context-v1",
    "cancellation_api": "runtime-v1",
    "platforms": ["windows"],
    "entrypoints": {"windows": "action.py"},
    "permissions": ["native_api", "screen_reader"],
    "params": [
        {
            "name": "target",
            "label": "屏幕控件",
            "type": "uia_selector",
            "value_type": "object",
            "required": true,
            "sensitive": true,
            "summary": "hidden"
        }
    ],
    "outputs": [
        {"name": "text", "label": "读取的文本", "type": "string", "sensitive": true, "summary": "hidden"},
        {"name": "display", "label": "控件说明", "type": "object", "summary": "shape"}
    ],
    "idempotent": true
}
