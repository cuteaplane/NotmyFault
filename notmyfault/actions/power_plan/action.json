{
    "id": "power_plan",
    "name": "切换电源计划",
    "description": "切换平衡/高性能/节能电源计划（Windows 用 powercfg，Linux 用 powerprofilesctl）",
    "version_code": 2,
    "version": "1.1",
    "package_name": "io.github.notmyfault.power_plan",
    "requires_capabilities": [
        "power.profile"
    ],
    "enabled": true,
    "idempotent": true,
    "platforms": [
        "windows",
        "linux"
    ],
    "permissions": [
        "external_binary"
    ],
    "outputs": [
        {
            "name": "plan",
            "label": "电源计划",
            "type": "string"
        },
        {
            "name": "guid",
            "label": "计划 GUID",
            "type": "string",
            "value_type": "uuid",
            "required": false
        },
        {
            "name": "profile",
            "label": "Linux 电源模式",
            "type": "string",
            "required": false
        }
    ],
    "params": [
        {
            "name": "plan",
            "label": "电源计划",
            "type": "select",
            "default": "balanced",
            "options": [
                {
                    "value": "balanced",
                    "label": "平衡"
                },
                {
                    "value": "high_performance",
                    "label": "高性能"
                },
                {
                    "value": "power_saver",
                    "label": "节能"
                },
                {
                    "value": "custom",
                    "label": "自定义 GUID（仅 Windows）"
                }
            ]
        },
        {
            "name": "custom_guid",
            "label": "自定义计划 GUID",
            "type": "string",
            "default": "",
            "placeholder": "如 381b4222-f694-41f0-9685-ff5bb260df2e",
            "visible_when": {
                "plan": [
                    "custom"
                ]
            }
        }
    ]
}
