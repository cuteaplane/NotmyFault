{
    "id": "shutdown_system",
    "name": "系统控制",
    "description": "关机、重启、注销、休眠、睡眠",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.shutdown_system",
    "enabled": true,
    "permissions": ["admin", "native_api"],
    "params": [
        {
            "name": "action",
            "label": "操作",
            "type": "select",
            "default": "shutdown",
            "options": ["shutdown", "restart", "logoff", "hibernate", "sleep"]
        },
        {
            "name": "force",
            "label": "强制（不等待应用响应）",
            "type": "bool",
            "default": true
        },
        {
            "name": "delay_seconds",
            "label": "延迟秒数",
            "type": "number",
            "default": 0
        }
    ]
}