{
  "id": "write_text",
  "name": "写入文本文件",
  "description": "保存文本为文件，路径和内容可引用触发数据或前序结果；默认不覆盖，可选择创建父目录",
  "version_code": 1,
  "version": "1.0",
  "package_name": "io.github.notmyfault.write_text",
  "enabled": true,
  "idempotent": false,
  "permissions": [
    "filesystem"
  ],
  "security": {
    "rule_approval": "admin_key",
    "literal_only_params": [
      "overwrite",
      "create_parents"
    ]
  },
  "execution_api": "context-v1",
  "outputs": [
    {
      "name": "file",
      "label": "文件路径",
      "type": "string",
      "value_type": "path"
    },
    {
      "name": "bytes",
      "label": "写入字节数",
      "type": "number",
      "value_type": "int"
    },
    {
      "name": "characters",
      "label": "字符数",
      "type": "number",
      "value_type": "int"
    }
  ],
  "params": [
    {
      "name": "file_path",
      "label": "文件路径",
      "type": "path",
      "default": "",
      "required": true,
      "value_type": "path"
    },
    {
      "name": "text",
      "label": "文本内容",
      "type": "textarea",
      "default": "",
      "sensitive": true,
      "summary": "hidden",
      "rows": 5,
      "value_type": "text"
    },
    {
      "name": "encoding",
      "label": "编码",
      "type": "string",
      "default": "utf-8",
      "options": [
        {
          "value": "utf-8",
          "label": "UTF-8"
        },
        {
          "value": "utf-8-sig",
          "label": "UTF-8 带 BOM"
        },
        {
          "value": "gbk",
          "label": "GBK"
        },
        {
          "value": "utf-16",
          "label": "UTF-16"
        }
      ],
      "value_type": "text",
      "placeholder": "utf-8、utf-8-sig、utf-16、gbk、gb18030、big5、shift_jis"
    },
    {
      "name": "overwrite",
      "label": "覆盖已有文件",
      "type": "bool",
      "default": false,
      "value_type": "bool"
    },
    {
      "name": "create_parents",
      "label": "创建父目录",
      "type": "bool",
      "default": false,
      "value_type": "bool"
    }
  ]
}
