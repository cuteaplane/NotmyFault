{
    "id": "set_volume",
    "name": "设置系统音量",
    "description": "根据参数将系统主音量调整到指定级别",
    "version_code": 2,
    "version": "1.1",
    "package_name": "io.github.notmyfault.set_volume",
    "requires_capabilities": ["audio.control"],
    "enabled": true,
    "idempotent": true,
    "execution_mode": "isolated",
    "platforms": ["windows", "linux"],
    "permissions": ["audio", "external_binary", "native_api"],
    "params": [
        {
            "name": "action",
            "label": "音量级别",
            "type": "select",
            "default": "max",
            "options": [
                {"value": "max", "label": "最大音量"},
                {"value": "half", "label": "一半音量"},
                {"value": "min", "label": "最小音量"},
                {"value": "mute", "label": "静音"}
            ]
        }
    ]
}
