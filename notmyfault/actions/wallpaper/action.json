{
    "id": "wallpaper",
    "name": "更换壁纸",
    "description": "设置桌面壁纸（支持图片路径和样式）",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.wallpaper",
    "enabled": true,
    "permissions": ["native_api", "filesystem"],
    "params": [
        {
            "name": "image_path",
            "label": "图片路径",
            "type": "string",
            "default": "",
            "placeholder": "支持 jpg/png/bmp"
        },
        {
            "name": "style",
            "label": "填充样式",
            "type": "select",
            "default": "fill",
            "options": ["fill", "fit", "stretch", "tile", "center"]
        }
    ]
}