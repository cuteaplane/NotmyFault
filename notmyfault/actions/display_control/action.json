{
    "id": "display_control",
    "name": "显示器控制",
    "description": "关闭显示器、调节亮度",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.display_control",
    "enabled": true,
    "permissions": ["native_api", "external_binary"],
    "params": [
        {
            "name": "action",
            "label": "操作",
            "type": "select",
            "default": "off",
            "options": ["off", "on", "low_brightness", "high_brightness"]
        }
    ]
}
