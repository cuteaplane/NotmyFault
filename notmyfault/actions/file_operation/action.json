{
    "id": "file_operation",
    "name": "文件操作",
    "description": "复制、移动、删除、压缩、解压文件或文件夹",
    "version_code": 2,
    "version": "1.1",
    "package_name": "io.github.notmyfault.file_operation",
    "enabled": true,
    "permissions": ["filesystem"],
    "security": {
        "rule_approval": "admin_key",
        "literal_only_params": ["operation", "destination"]
    },
    "params": [
        {
            "name": "operation",
            "label": "操作类型",
            "type": "select",
            "default": "copy",
            "options": [
                {"value": "copy", "label": "复制"},
                {"value": "move", "label": "移动"},
                {"value": "delete", "label": "删除"},
                {"value": "compress", "label": "压缩"},
                {"value": "extract", "label": "解压"}
            ]
        },
        {
            "name": "source",
            "label": "源路径",
            "type": "string",
            "default": "",
            "placeholder": "文件或文件夹路径"
        },
        {
            "name": "destination",
            "label": "目标路径",
            "type": "string",
            "default": "",
            "placeholder": "仅 copy/move/compress 需要"
        }
    ]
}
