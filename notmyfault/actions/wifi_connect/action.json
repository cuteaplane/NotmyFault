{
    "id": "wifi_connect",
    "name": "连接 WiFi",
    "description": "连接或断开指定 WiFi 网络（SSID）",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.wifi_connect",
    "enabled": true,
    "idempotent": false,
    "platforms": ["windows", "linux"],
    "permissions": ["external_binary", "native_api"],
    "outputs": [
        {"name": "action", "label": "执行的操作", "type": "string"},
        {"name": "ssid", "label": "当前网络", "type": "string"},
        {"name": "previous_ssid", "label": "操作前网络", "type": "string"},
        {"name": "connected", "label": "是否已连接", "type": "bool"},
        {"name": "changed", "label": "是否发生切换", "type": "bool"},
        {"name": "method", "label": "控制方式", "type": "string"}
    ],
    "params": [
        {
            "name": "action",
            "label": "操作",
            "type": "select",
            "default": "connect",
            "options": [
                {"value": "connect", "label": "连接目标 WiFi"},
                {"value": "disconnect", "label": "断开当前 WiFi"}
            ]
        },
        {
            "name": "ssid",
            "label": "目标 SSID",
            "type": "string",
            "default": "",
            "placeholder": "如 MyHomeWiFi",
            "visible_when": {"action": ["connect"]}
        },
        {
            "name": "password",
            "label": "密码",
            "type": "string",
            "default": "",
            "placeholder": "已保存的网络可留空；Windows 需事先保存过该网络",
            "visible_when": {"action": ["connect"]}
        }
    ]
}
