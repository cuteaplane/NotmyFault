{
    "id": "process_state",
    "name": "进程状态扫描器",
    "semantic": "state",
    "trigger_api": "event-v2",
    "description": "持续扫描进程状态并在目标状态到达时通知主程序",
    "version_code": 2,
    "version": "1.1",
    "package_name": "io.github.notmyfault.process_state",
    "enabled": true,
    "outputs": [
        {"name": "process_name", "label": "进程名称", "type": "string"},
        {"name": "state", "label": "进程状态", "type": "string"}
    ],
    "params": [
        {
            "name": "process_name",
            "label": "进程名",
            "type": "string",
            "default": "WeChat.exe",
            "placeholder": "如 WeChat.exe、notepad.exe"
        },
        {
            "name": "state",
            "label": "触发状态",
            "type": "select",
            "default": "running",
            "options": [
                {"value": "running", "label": "进程正在运行"},
                {"value": "stopped", "label": "进程已经停止"}
            ]
        }
    ]
}
