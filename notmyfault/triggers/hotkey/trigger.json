{
    "id": "hotkey",
    "name": "全局热键",
    "semantic": "oneshot",
    "trigger_api": "event-v2",
    "description": "按下指定全局热键时触发动作",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.hotkey",
    "requires_capabilities": ["input.global_hotkey"],
    "platforms": ["windows", "linux"],
    "enabled": true,
    "permissions": ["native_api"],
    "components": [
        {
            "id": "record",
            "name": "录制热键",
            "description": "按下按键后返回对应的热键",
            "entrypoint": "component.py",
            "param_types": ["hotkey"],
            "ui": {
                "button_label": "录制",
                "icon": "keyboard"
            }
        }
    ],
    "outputs": [
        {"name": "hotkey", "label": "触发热键", "type": "string"}
    ],
    "params": [
        {
            "name": "hotkey",
            "label": "快捷键",
            "type": "hotkey",
            "default": "Ctrl+Alt+Shift+X",
            "placeholder": "如 Ctrl+Shift+A、Alt+F1"
        }
    ]
}
