{
    "id": "system_startup",
    "name": "引擎启动",
    "semantic": "oneshot",
    "trigger_api": "event-v2",
    "description": "系统启动后延迟指定秒数触发一次；同一配置在同一次系统启动中只触发一次",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.system_startup",
    "outputs": [
        {
            "name": "started_at",
            "label": "触发器启动时间",
            "type": "string",
            "value_type": {
                "type": "datetime",
                "timezone": "naive"
            }
        },
        {
            "name": "delay_seconds",
            "label": "延迟秒数",
            "type": "number",
            "value_type": {
                "type": "duration",
                "unit": "seconds"
            }
        }
    ],
    "params": [
        {
            "name": "delay_seconds",
            "label": "延迟（秒）",
            "type": "number",
            "default": 5,
            "min": 0,
            "max": 300,
            "step": 1,
            "placeholder": "等系统/网络就绪后再触发",
            "value_type": {
                "type": "duration",
                "unit": "seconds"
            }
        }
    ],
    "lifecycle": "one_shot"
}
