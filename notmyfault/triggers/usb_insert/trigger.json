{
    "id": "usb_insert",
    "name": "U盘插入监控",
    "semantic": "oneshot",
    "trigger_api": "event-v2",
    "description": "监控可移动磁盘(U盘)的插入事件",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.usb_insert",
    "enabled": true,
    "outputs": [
        {
            "name": "drive_letter",
            "label": "匹配盘符",
            "type": "string"
        },
        {
            "name": "actual_drive",
            "label": "实际盘符",
            "type": "string",
            "format": "path",
            "value_type": "path"
        }
    ],
    "params": [
        {
            "name": "drive_letter",
            "label": "盘符或挂载路径",
            "type": "string",
            "default": "ANY",
            "placeholder": "Windows: E:；Linux: /media/user/USB；ANY 表示任意设备"
        }
    ],
    "platforms": [
        "windows",
        "linux"
    ]
}
