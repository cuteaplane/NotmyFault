{
    "id": "network_status",
    "name": "网络状态变化",
    "semantic": "state",
    "trigger_api": "event-v1",
    "description": "网络连接/断开时触发",
    "version_code": 2,
    "version": "1.1",
    "package_name": "io.github.notmyfault.network_status",
    "enabled": true,
    "permissions": ["network"],
    "params": [
        {
            "name": "state",
            "label": "目标状态",
            "type": "select",
            "default": "disconnected",
            "options": [
                {"value": "connected", "label": "网络已连接"},
                {"value": "disconnected", "label": "网络已断开"}
            ]
        }
    ]
}
