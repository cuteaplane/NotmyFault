{
  "id": "path_exists",
  "name": "路径出现或消失",
  "description": "轮询指定文件或目录的存在状态，状态改变时触发。首次读取只记录状态，不触发。",
  "version_code": 1,
  "version": "1.0",
  "package_name": "io.github.notmyfault.path_exists",
  "enabled": true,
  "semantic": "state",
  "trigger_api": "event-v2",
  "permissions": [
    "filesystem"
  ],
  "outputs": [
    {
      "name": "path",
      "label": "监控路径",
      "type": "string",
      "format": "path",
      "sensitive": true,
      "value_type": "path"
    },
    {
      "name": "state",
      "label": "当前状态",
      "type": "string",
      "value_type": "text"
    },
    {
      "name": "exists",
      "label": "符合类型的路径存在",
      "type": "bool",
      "value_type": "bool"
    }
  ],
  "params": [
    {
      "name": "path",
      "label": "监控路径",
      "type": "path",
      "default": "",
      "required": true,
      "sensitive": true,
      "placeholder": "文件或目录的完整路径",
      "value_type": "path"
    },
    {
      "name": "kind",
      "label": "路径类型",
      "type": "select",
      "default": "any",
      "options": [
        {
          "value": "any",
          "label": "文件或目录"
        },
        {
          "value": "file",
          "label": "仅文件"
        },
        {
          "value": "directory",
          "label": "仅目录"
        }
      ]
    },
    {
      "name": "state",
      "label": "触发时机",
      "type": "select",
      "default": "exists",
      "options": [
        {
          "value": "exists",
          "label": "路径出现"
        },
        {
          "value": "missing",
          "label": "路径消失"
        },
        {
          "value": "changed",
          "label": "出现或消失"
        }
      ]
    },
    {
      "name": "interval",
      "label": "检查间隔（秒，0.2–3600）",
      "type": "number",
      "default": 1,
      "min": 0.2,
      "max": 3600,
      "step": 0.1,
      "value_type": {
        "type": "duration",
        "unit": "seconds"
      }
    }
  ]
}
