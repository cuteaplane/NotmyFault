{
    "id": "power_state",
    "name": "电源状态监测",
    "semantic": "state",
    "trigger_api": "event-v2",
    "description": "电源接入/电池/低电量/休眠恢复时触发",
    "version_code": 2,
    "version": "1.1",
    "package_name": "io.github.notmyfault.power_state",
    "enabled": true,
    "permissions": ["native_api"],
    "outputs": [
        {"name": "state", "label": "电源状态", "type": "string"},
        {"name": "battery_percent", "label": "电池电量", "type": "number"}
    ],
    "params": [
        {
            "name": "state",
            "label": "状态",
            "type": "select",
            "default": "ac",
            "options": [
                {"value": "ac", "label": "已接通电源"},
                {"value": "battery", "label": "正在使用电池"},
                {"value": "low_battery", "label": "电池电量低"},
                {"value": "resume", "label": "从睡眠中恢复"}
            ]
        }
    ]
}
