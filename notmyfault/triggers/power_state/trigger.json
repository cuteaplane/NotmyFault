{
    "id": "power_state",
    "name": "电源状态监测",
    "semantic": "state",
    "trigger_api": "event-v2",
    "description": "电源接入/电池/低电量/休眠恢复时触发",
    "version_code": 3,
    "version": "1.2",
    "package_name": "io.github.notmyfault.power_state",
    "permissions": [
        "native_api"
    ],
    "outputs": [
        {
            "name": "state",
            "label": "电源状态",
            "type": "string"
        },
        {
            "name": "battery_percent",
            "label": "电池电量",
            "type": "number",
            "value_type": "int"
        }
    ],
    "params": [
        {
            "name": "state",
            "label": "状态",
            "type": "select",
            "default": "ac",
            "options": [
                {
                    "value": "ac",
                    "label": "已接通电源"
                },
                {
                    "value": "battery",
                    "label": "正在使用电池"
                },
                {
                    "value": "low_battery",
                    "label": "电池电量低"
                },
                {
                    "value": "resume",
                    "label": "从睡眠恢复"
                }
            ]
        }
    ],
    "platforms": [
        "windows",
        "linux"
    ],
    "state_key": "state",
    "state_filter": {
        "default": {
            "state": {
                "config": "state"
            }
        }
    },
    "state_untracked": [
        "resume"
    ],
    "state_hysteresis": {
        "value": "battery_percent",
        "threshold": 20,
        "direction": "below",
        "margin": 5,
        "active_value": "low_battery",
        "when": {
            "state": "low_battery"
        },
        "guard": {
            "state": "battery"
        }
    }
}
