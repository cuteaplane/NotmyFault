{
    "id": "folder_monitor",
    "name": "文件夹监控",
    "semantic": "oneshot",
    "description": "监控文件夹内文件的新增、修改、删除",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.folder_monitor",
    "enabled": true,
    "permissions": ["filesystem"],
    "params": [
        {
            "name": "folder_path",
            "label": "监控目录",
            "type": "string",
            "default": "",
            "placeholder": "如 C:\\Users\\Me\\Downloads"
        },
        {
            "name": "event_type",
            "label": "事件类型",
            "type": "select",
            "default": "created",
            "options": ["created", "modified", "deleted", "all"]
        },
        {
            "name": "file_pattern",
            "label": "文件名过滤",
            "type": "string",
            "default": "*",
            "placeholder": "如 *.txt、*.log（留空=全部）"
        }
    ]
}