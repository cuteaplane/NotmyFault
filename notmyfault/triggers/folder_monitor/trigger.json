{
    "id": "folder_monitor",
    "name": "文件夹监控",
    "semantic": "oneshot",
    "trigger_api": "event-v2",
    "description": "监控文件夹内文件的新增、修改、删除",
    "version_code": 2,
    "version": "1.1",
    "package_name": "io.github.notmyfault.folder_monitor",
    "enabled": true,
    "permissions": ["filesystem"],
    "outputs": [
        {"name": "event", "label": "变化类型", "type": "string"},
        {"name": "path", "label": "变化文件", "type": "string", "format": "path"},
        {"name": "folder", "label": "监控目录", "type": "string", "format": "path"}
    ],
    "params": [
        {
            "name": "folder_path",
            "label": "监控目录",
            "type": "string",
            "default": "",
            "placeholder": "如 C:\\Users\\Me\\Downloads"
        },
        {
            "name": "event_type",
            "label": "事件类型",
            "type": "select",
            "default": "created",
            "options": [
                {"value": "created", "label": "新建文件"},
                {"value": "modified", "label": "修改文件"},
                {"value": "deleted", "label": "删除文件"},
                {"value": "all", "label": "任意变化"}
            ]
        },
        {
            "name": "file_pattern",
            "label": "文件名过滤",
            "type": "string",
            "default": "*",
            "placeholder": "如 *.txt、*.log（留空=全部）"
        }
    ]
}
