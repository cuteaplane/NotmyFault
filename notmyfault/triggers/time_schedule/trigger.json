{
    "id": "time_schedule",
    "name": "定时触发",
    "semantic": "oneshot",
    "trigger_api": "event-v2",
    "description": "在指定时间（HH:MM 格式）每日触发一次",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.time_schedule",
    "enabled": true,
    "outputs": [
        {"name": "triggered_time", "label": "触发时间", "type": "string"}
    ],
    "params": [
        {
            "name": "time",
            "label": "触发时间",
            "type": "time",
            "default": "22:00",
            "placeholder": "HH:MM 格式，如 08:30、22:00"
        }
    ]
}
