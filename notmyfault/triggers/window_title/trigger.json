{
    "id": "window_title",
    "name": "窗口标题检测",
    "semantic": "state",
    "trigger_api": "event-v2",
    "description": "检测包含特定关键词的窗口出现或关闭",
    "version_code": 2,
    "version": "1.1",
    "package_name": "io.github.notmyfault.window_title",
    "platforms": ["windows", "linux"],
    "enabled": true,
    "permissions": [
        "native_api","external_binary"
    ],
    "outputs": [
        {"name": "title_pattern", "label": "匹配规则", "type": "string"},
        {"name": "state", "label": "窗口状态", "type": "string"},
        {"name": "matched_title", "label": "匹配标题", "type": "string"}
    ],
    "params": [
        {
            "name": "title_pattern",
            "label": "标题关键词",
            "type": "string",
            "default": "",
            "placeholder": "匹配窗口标题包含的关键词"
        },
        {
            "name": "state",
            "label": "触发状态",
            "type": "select",
            "default": "opened",
            "options": [
                {"value": "opened", "label": "窗口已打开"},
                {"value": "closed", "label": "窗口已关闭"}
            ]
        }
    ]
}
