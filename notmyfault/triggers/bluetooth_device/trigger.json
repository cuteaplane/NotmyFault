{
    "id": "bluetooth_device",
    "name": "蓝牙设备检测",
    "semantic": "state",
    "trigger_api": "event-v1",
    "description": "监控蓝牙设备的连接和断开事件",
    "version_code": 2,
    "version": "1.1",
    "package_name": "io.github.notmyfault.bluetooth_device",
    "enabled": false,
    "permissions": [
        "external_binary"
    ],
    "params": [
        {
            "name": "device_name",
            "label": "设备名关键词",
            "type": "string",
            "default": "",
            "placeholder": "留空匹配任意设备，或输入关键词（如 JBL）"
        },
        {
            "name": "state",
            "label": "触发状态",
            "type": "select",
            "default": "connected",
            "options": [
                {"value": "connected", "label": "设备已连接"},
                {"value": "disconnected", "label": "设备已断开"}
            ]
        }
    ]
}
