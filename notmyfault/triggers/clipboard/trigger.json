{
    "id": "clipboard",
    "name": "剪贴板监控",
    "semantic": "oneshot",
    "description": "剪贴板内容发生变化时触发",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.clipboard",
    "enabled": true,
    "permissions": ["clipboard", "native_api"],
    "params": [
        {
            "name": "match_text",
            "label": "匹配文本",
            "type": "string",
            "default": "",
            "placeholder": "留空=任何变化都触发"
        }
    ]
}