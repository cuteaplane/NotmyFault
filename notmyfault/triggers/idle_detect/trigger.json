{
    "id": "idle_detect",
    "name": "系统空闲检测",
    "semantic": "state",
    "trigger_api": "event-v2",
    "description": "检测系统无键盘鼠标操作的闲置时间，在进入/退出空闲状态时触发",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.idle_detect",
    "enabled": true,
    "platforms": ["windows", "linux"],
    "permissions": [
        "native_api",
        "external_binary"
    ],
    "outputs": [
        {
            "name": "state",
            "label": "活动状态",
            "type": "string"
        },
        {
            "name": "idle_seconds",
            "label": "空闲秒数",
            "type": "number",
            "value_type": {
                "type": "duration",
                "unit": "seconds"
            }
        }
    ],
    "params": [
        {
            "name": "idle_seconds",
            "label": "空闲秒数",
            "type": "number",
            "default": 300,
            "placeholder": "空闲多少秒后触发（默认300秒=5分钟）",
            "value_type": {
                "type": "duration",
                "unit": "seconds"
            }
        }
    ]
}
