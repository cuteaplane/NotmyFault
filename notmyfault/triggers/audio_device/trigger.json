{
    "id": "audio_device",
    "name": "音频设备变化",
    "semantic": "state",
    "trigger_api": "event-v2",
    "description": "默认播放/录音设备切换时触发",
    "version_code": 1,
    "version": "1.0",
    "package_name": "io.github.notmyfault.audio_device",
    "enabled": true,
    "platforms": ["windows"],
    "permissions": ["external_binary"],
    "outputs": [
        {"name": "device_type", "label": "设备类型", "type": "string"},
        {"name": "device_id", "label": "当前设备", "type": "string"},
        {"name": "previous_device_id", "label": "上一个设备", "type": "string"},
        {"name": "changed", "label": "是否变化", "type": "bool"}
    ],
    "params": [
        {
            "name": "device_type",
            "label": "设备类型",
            "type": "select",
            "default": "render",
            "options": [
                {"value": "render", "label": "播放设备"},
                {"value": "capture", "label": "录音设备"},
                {"value": "any", "label": "任意变化"}
            ]
        }
    ]
}
